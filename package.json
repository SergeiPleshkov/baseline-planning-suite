{
  "name": "baseline-planning-suite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "pnpm --filter @baseline/e2e e2e",
    "lint": "eslint .",
    "knip": "knip",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "knip": "^6.39.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "prettier --write",
      "eslint"
    ],
    "!(*.{js,mjs,cjs,ts,tsx})": "prettier --write --ignore-unknown"
  }
}
