# The one public entry point: the shell, and the same-origin path to each remote.
# Upstreams are resolved per request, so the gateway starts and stays up while a remote is down;
# only that remote's paths answer 502 and its panel shows the failure.
resolver 127.0.0.11 valid=5s ipv6=off;
resolver_timeout 2s;

server {
  listen 8080;
  root /usr/share/nginx/html;
  gzip on;
  gzip_types application/javascript application/json text/css;

  location = /config.json {
    expires -1;
  }

  location = /index.html {
    expires -1;
  }

  location /static/ {
    expires 1y;
    try_files $uri =404;
  }

  location = /mf/people {
    return 301 /mf/people/;
  }

  location /mf/people/ {
    set $upstream ${PEOPLE_UPSTREAM};
    rewrite ^/mf/people/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_connect_timeout 2s;
  }

  location = /mf/delivery {
    return 301 /mf/delivery/;
  }

  location /mf/delivery/ {
    set $upstream ${DELIVERY_UPSTREAM};
    rewrite ^/mf/delivery/(.*)$ /$1 break;
    proxy_pass $upstream;
    proxy_connect_timeout 2s;
  }

  location / {
    try_files $uri /index.html;
  }
}
